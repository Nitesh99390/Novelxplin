rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user owns exactly one doc: library, history, profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Chapter comments: anyone can read, signed-in users can post their own
    match /comments/{novel}/{chapter}/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || request.auth.token.email == "bhuimharniteshbhuimhar@gmail.com");
    }
  }
}
