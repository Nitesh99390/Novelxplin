rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed-in Google account with a verified e-mail, lower-cased. The admin panel stores
    // admins/{email} lower-cased, and Google may report mixed-case addresses in the token,
    // so every comparison goes through this normalised value.
    function email() {
      return request.auth != null && request.auth.token.email_verified == true
        ? request.auth.token.email.lower() : "";
    }
    // Site owner (same as ADMIN_EMAILS in src/js/config.js) – keep this lower-case
    function isOwner() {
      return email() == "bhuimharniteshbhuimhar@gmail.com";
    }
    // Extra admins: owner mirrors data/admins.json into admins/{email} from the admin panel
    function isAdmin() {
      return isOwner() || (email() != ""
        && exists(/databases/$(database)/documents/admins/$(email())));
    }

    // Each user owns exactly one doc: library, history, profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Admin list – readable by signed-in users, writable only by the owner
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }
    // Chapter comments: anyone can read, signed-in users can post their own
    match /comments/{novel}/{chapter}/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
